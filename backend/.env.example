DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mavrov
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# --- Site identity (#65) — rebrand a prebuilt image with env alone ---
# Served to the public frontend at runtime via GET /api/app/config/site.
SITE_NAME=My Portfolio
SITE_URL=https://example.com
OWNER_NAME=Jane Doe
OWNER_HEADLINE=Software Engineer
OWNER_DESCRIPTION=Professional portfolio of Jane Doe, a Software Engineer.
# Comma-separated public profile URLs (JSON-LD sameAs + contact links).
SOCIAL_LINKS=https://linkedin.com/in/janedoe,https://github.com/janedoe
# Google Analytics measurement id; leave empty to disable analytics.
HIREFOLIO_ANALYTICS_ID=
# Comma-separated CORS allowlist for the API.
CORS_ORIGINS=http://localhost:4200,https://example.com
