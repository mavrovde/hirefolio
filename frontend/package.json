{
  "name": "frontend",
  "version": "1.5.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve public",
    "start:admin": "ng serve admin",
    "build:shared": "ng build shared",
    "build:public": "ng build public",
    "build:admin": "ng build admin",
    "build": "npm run build:shared && npm run build:public && npm run build:admin",
    "watch": "ng build public --watch --configuration development",
    "test:shared": "vitest run --config projects/shared/vitest.config.ts",
    "test:public": "vitest run --config projects/public/vitest.config.ts",
    "test:admin": "vitest run --config projects/admin/vitest.config.ts",
    "test": "npm run test:shared && npm run test:public && npm run test:admin",
    "test:coverage:shared": "vitest run --coverage --config projects/shared/vitest.config.ts",
    "test:coverage:public": "vitest run --coverage --config projects/public/vitest.config.ts",
    "test:coverage:admin": "vitest run --coverage --config projects/admin/vitest.config.ts",
    "test:coverage": "npm run test:coverage:shared && npm run test:coverage:public && npm run test:coverage:admin",
    "e2e": "npx playwright test",
    "serve:ssr:public": "node dist/public/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "overrides": {
    "undici": "^7.29.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-server": "^21.2.18",
    "@angular/router": "^21.2.18",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/ssr": "^21.2.19",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^27.4.0",
    "ng-packagr": "^22.0.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "undici": "^7.29.0",
    "vitest": "^4.1.10"
  }
}
