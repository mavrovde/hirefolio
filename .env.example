# ---------------------------------------------------------------------------
# Root environment for deploying mavrov.de under a NEW owner.
#
# Copy to `.env` (gitignored) and adjust. Every value below has a safe default
# baked into the compose files / proxy, so an unset variable keeps the canonical
# behavior — a forker only needs to override the handful that identify THEM.
# Docker Compose auto-loads `.env` from the project root.
# ---------------------------------------------------------------------------

# --- Container images (registry / org / name) ------------------------------
# Prod compose pulls `${IMAGE_REPO}-{backend,frontend,admin-frontend,proxy}:${IMAGE_TAG}`.
# Default org is Docker Hub `maverickde/mavrov.de`; dev compose defaults to a local
# `mavrovde` prefix. Point IMAGE_REPO at YOUR registry/org to pull/deploy your images:
#   IMAGE_REPO=ghcr.io/<your-gh-user>/<your-repo>
# IMAGE_REPO=maverickde/mavrov.de
# Pinned release tag to run in prod (defaults to the repo's current VERSION).
# IMAGE_TAG=1.7.1
#
# NOTE: CI publishing (.github/workflows/deploy.yml) is driven by GitHub *repository
# variables*, not this file — set REGISTRY and IMAGE_NAME under
# Settings -> Secrets and variables -> Actions -> Variables to retarget the publish.
# Defaults there keep publishing to ghcr.io/<owner>/<repo>.

# --- Public domain / proxy server_name -------------------------------------
# The reverse proxy answers on these hostnames (space-separated is allowed).
# Set them to YOUR domain; loopback + localhost stay allowed automatically.
# PUBLIC_SERVER_NAME=mavrov.de www.mavrov.de
# ADMIN_SERVER_NAME=admin.mavrov.de admin.localhost

# --- Admin console allowlist (SECURITY) ------------------------------------
# The admin subdomain is CLOSED by default: only loopback reaches it. To grant
# trusted operator IPs/CIDRs, list them here (space- or comma-separated). The
# proxy appends a final `deny all;`, so anything not listed is rejected.
# Never set this to 0.0.0.0/0 in production — that re-opens admin to the world.
# ADMIN_ALLOWED_CIDRS=203.0.113.7 198.51.100.0/24

# --- Database ---------------------------------------------------------------
# Postgres port (container listen port + host mapping + backend DATABASE_URL).
# POSTGRES_PORT=5433
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=mavrov

# --- App secrets / integrations --------------------------------------------
# GEMINI_API_KEY=your_api_key_here
# LINKEDIN_IMPORT_TOKEN=your_machine_token_here

# --- Pinned base images (documented; edit in docker-compose.prod.yml +
#     .github/base-images.txt if you must move them) --------------------------
#   db:         pgvector/pgvector:pg16
#   ollama:     ollama/ollama:0.5.7
#   open-webui: ghcr.io/open-webui/open-webui:v0.5.10
