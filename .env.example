# ---------------------------------------------------------------------------
# Root environment for deploying mavrov.de under a NEW owner.
#
# Copy to `.env` (gitignored) and adjust. Every value below has a safe default
# baked into the compose files / proxy, so an unset variable keeps the canonical
# behavior — a forker only needs to override the handful that identify THEM.
# Docker Compose auto-loads `.env` from the project root.
# ---------------------------------------------------------------------------

# --- Container images (registry / org / name) ------------------------------
# Prod compose pulls `${IMAGE_REPO}-{backend,frontend,admin-frontend,proxy}:${IMAGE_TAG}`.
# Default org is Docker Hub `maverickde/mavrov.de`; dev compose defaults to a local
# `mavrovde` prefix. Point IMAGE_REPO at YOUR registry/org to pull/deploy your images:
#   IMAGE_REPO=ghcr.io/<your-gh-user>/<your-repo>
# IMAGE_REPO=maverickde/mavrov.de
# Pinned release tag to run in prod (defaults to the repo's current VERSION).
# IMAGE_TAG=1.7.1
#
# NOTE: CI publishing (.github/workflows/deploy.yml) is driven by GitHub *repository
# variables*, not this file — set REGISTRY and IMAGE_NAME under
# Settings -> Secrets and variables -> Actions -> Variables to retarget the publish.
# Defaults there keep publishing to ghcr.io/<owner>/<repo>.

# --- Public domain / proxy server_name -------------------------------------
# The reverse proxy answers on these hostnames (space-separated is allowed).
# Set them to YOUR domain; loopback + localhost stay allowed automatically.
# PUBLIC_SERVER_NAME=mavrov.de www.mavrov.de
# ADMIN_SERVER_NAME=admin.mavrov.de admin.localhost

# --- Admin console access hardening (SECURITY, #86) ------------------------
# The admin subdomain ships CLOSED to the public. With ADMIN_ALLOWED_CIDRS empty
# (the default) only loopback reaches it; the proxy appends a final `deny all;`,
# so anything not explicitly allowed is rejected. NEVER emits a blanket allow.
#
# HOW IT WORKS: in the containerized prod topology admin traffic reaches nginx via
# the Docker bridge gateway (Docker NAT masks the external source IP), so the proxy
# uses nginx real_ip to recover the true client IP from the front proxy's forwarded
# header BEFORE applying the allowlist. Two knobs must agree:
#
#   1) TRUSTED_PROXY_CIDRS — upstream CIDR(s) nginx trusts for the forwarded header.
#      Default 172.16.0.0/12 (Docker bridge range). Tighten to your exact front-proxy
#      CIDR if you can. Only trust what you control — a trusted hop can spoof the header.
#   2) REAL_IP_HEADER — the header carrying the real client IP. Default X-Forwarded-For.
#      If your front proxy (e.g. 1panel/OpenResty) sends X-Real-IP instead, set that.
#   3) ADMIN_ALLOWED_CIDRS — the real operator IPs/CIDRs allowed in (space/comma list).
#
# TRUSTED_PROXY_CIDRS=172.16.0.0/12
# REAL_IP_HEADER=X-Forwarded-For
# ADMIN_ALLOWED_CIDRS=203.0.113.7 198.51.100.0/24
#
# Never set ADMIN_ALLOWED_CIDRS=0.0.0.0/0 in production — that re-opens admin to the
# world. BREAK-GLASS (works even with an empty allowlist): reach admin over loopback
# from ON the box, e.g. `docker compose exec proxy wget -qO- --no-check-certificate \
#   --header 'Host: admin.<your-domain>' https://127.0.0.1/`, or an SSH tunnel that
# originates inside the proxy container's network namespace.

# --- Database ---------------------------------------------------------------
# Postgres port (container listen port + host mapping + backend DATABASE_URL).
# POSTGRES_PORT=5433
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=mavrov

# --- App secrets / integrations --------------------------------------------
# GEMINI_API_KEY=your_api_key_here
# LINKEDIN_IMPORT_TOKEN=your_machine_token_here
# Directory (inside the backend container) where the saved LinkedIn login
# session is stored. Defaults to /data/linkedin_cookies, which is backed by the
# `linkedin_cookies` named volume so the session survives container recreates.
# LINKEDIN_COOKIES_DIR=/data/linkedin_cookies

# --- Pinned base images (documented; edit in docker-compose.prod.yml +
#     .github/base-images.txt if you must move them) --------------------------
#   db:         pgvector/pgvector:pg16
#   ollama:     ollama/ollama:0.5.7
#   open-webui: ghcr.io/open-webui/open-webui:v0.5.10
